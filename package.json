{
  "name": "srdl",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^6",
      "next-themes": "^0.4.6",
      "convex": "^1.33.1",
      "better-auth": "1.6.9",
      "@convex-dev/better-auth": "^0.12.1",
      "@types/react-dom": "^19.2.3",
      "@types/node": "^24.10.1",
      "nuqs": "^2.8.9",
      "@dnd-kit/core": "^6.3.1",
      "@dnd-kit/modifiers": "^9.0.0",
      "@dnd-kit/sortable": "^10.0.0",
      "@dnd-kit/utilities": "^3.2.2",
      "@radix-ui/react-slot": "^1.2.4"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @srdl/backend dev",
    "dev:setup": "turbo -F @srdl/backend dev:setup",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "commit": "cz",
    "commit:check": "commitlint --edit"
  },
  "dependencies": {
    "@srdl/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@srdl/config": "workspace:*",
    "commitizen": "^4.3.1",
    "cz-git": "^1.13.0",
    "lefthook": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.8.12",
    "typescript": "catalog:",
    "ultracite": "7.6.2"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "packageManager": "bun@1.3.5",
  "cz-git": {
    "disableEmoji": true,
    "allowCustomScopes": true,
    "allowBreakingChanges": [
      "feat",
      "fix",
      "refactor"
    ],
    "types": [
      {
        "value": "feat",
        "name": "feat: add a new feature"
      },
      {
        "value": "fix",
        "name": "fix: fix a bug"
      },
      {
        "value": "docs",
        "name": "docs: update documentation"
      },
      {
        "value": "style",
        "name": "style: formatting or non-functional style changes"
      },
      {
        "value": "refactor",
        "name": "refactor: change code without fixing a bug or adding a feature"
      },
      {
        "value": "perf",
        "name": "perf: improve performance"
      },
      {
        "value": "test",
        "name": "test: add or update tests"
      },
      {
        "value": "build",
        "name": "build: change build tooling or dependencies"
      },
      {
        "value": "ci",
        "name": "ci: change CI or automation"
      },
      {
        "value": "chore",
        "name": "chore: routine maintenance"
      },
      {
        "value": "revert",
        "name": "revert: revert a previous commit"
      }
    ]
  }
}
